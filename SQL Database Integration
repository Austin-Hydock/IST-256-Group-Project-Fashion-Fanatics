CREATE DATABASE IF NOT EXISTS fashion_fanatics;
USE fashion_fanatics;
 
 
CREATE TABLE members (
    member_id     INT AUTO_INCREMENT PRIMARY KEY,
    full_name     VARCHAR(100)  NOT NULL,
    age           INT           NOT NULL,
    email         VARCHAR(150)  NOT NULL UNIQUE,
    address       VARCHAR(255)  NOT NULL,
    phone         VARCHAR(20),
    created_at    TIMESTAMP     DEFAULT CURRENT_TIMESTAMP
);
 
 
CREATE TABLE products (
    product_id    INT           PRIMARY KEY,
    title         VARCHAR(150)  NOT NULL,
    type          VARCHAR(100)  NOT NULL,
    category      VARCHAR(100)  NOT NULL,
    price         DECIMAL(10,2) NOT NULL,
    image_url     VARCHAR(500),
    extra_info    TEXT,
    created_at    TIMESTAMP     DEFAULT CURRENT_TIMESTAMP
);
 
 
CREATE TABLE cart (
    cart_id       INT AUTO_INCREMENT PRIMARY KEY,
    member_id     INT,
    product_id    INT           NOT NULL,
    description   VARCHAR(255)  NOT NULL,
    category      VARCHAR(100)  NOT NULL,
    unit          VARCHAR(50)   NOT NULL,
    price         DECIMAL(10,2) NOT NULL,
    added_at      TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (member_id)  REFERENCES members(member_id)  ON DELETE SET NULL,
    FOREIGN KEY (product_id) REFERENCES products(product_id) ON DELETE CASCADE
);
 
 
CREATE TABLE authors (
    author_id     INT AUTO_INCREMENT PRIMARY KEY,
    member_id     INT,                          -- optional link to a registered member
    author_name   VARCHAR(100) NOT NULL,
    email         VARCHAR(150),
    FOREIGN KEY (member_id) REFERENCES members(member_id) ON DELETE SET NULL
);
 
 
CREATE TABLE articles (
    article_id      INT AUTO_INCREMENT PRIMARY KEY,
    author_id       INT           NOT NULL,
    title           VARCHAR(200)  NOT NULL,
    category        ENUM('Pop Culture', 'Fashion', 'Celebrity News') NOT NULL,
    pub_date        DATE          NOT NULL,
    review_status   ENUM(
                        'Draft',
                        'Submitted for Review',
                        'Approved for Publication',
                        'Published'
                    ) NOT NULL DEFAULT 'Draft',
    editorial_notes TEXT,
    submitted_at    TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (author_id) REFERENCES authors(author_id) ON DELETE CASCADE
);
 
 
CREATE TABLE article_channels (
    channel_id    INT AUTO_INCREMENT PRIMARY KEY,
    article_id    INT          NOT NULL,
    channel_name  ENUM('Website', 'Print Edition', 'Social Media') NOT NULL,
    FOREIGN KEY (article_id) REFERENCES articles(article_id) ON DELETE CASCADE
);
 
 
CREATE TABLE article_approvals (
    approval_id     INT AUTO_INCREMENT PRIMARY KEY,
    article_id      INT           NOT NULL UNIQUE,
    reviewed_by     VARCHAR(100)  NOT NULL,          -- admin username
    decision        ENUM('Approved', 'Rejected') NOT NULL,
    reviewed_at     TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (article_id) REFERENCES articles(article_id) ON DELETE CASCADE
);
 
 
