:root {
    --bg-color: #f9f6f1;
    --text-dark: #1a1a1a;
    --text-mid: #4a4a4a;
    --text-light: #888;
    --accent: #b89a5a;
    --accent-hover: #9a7e3f;
    --card-bg: #ffffff;
    --border: #e0d8cc;
    --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    --shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.14);
    --font-display: Georgia, 'Times New Roman', serif;
    --font-body: 'Helvetica Neue', Arial, sans-serif;
}
 

*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
 
body {
    background-color: var(--bg-color);
    color: var(--text-dark);
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 15px;
    line-height: 1.7;
    min-height: 100vh;
}
 

nav {
    background-color: var(--text-dark);
    padding: 14px 40px;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.1em;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
}
 
nav a {
    color: #c8b98a;
    text-decoration: none;
    transition: color 0.2s ease;
    padding: 2px 0;
}
 
nav a:hover {
    color: #ffffff;
}
 

nav {
    /* pipe chars styled via color blending into background */
}
 
/* ---- Main Heading ---- */
h1 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 700;
    text-align: center;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dark);
    padding: 48px 20px 8px;
}
 
hr {
    border: none;
    border-top: 1px solid var(--accent);
    width: 80px;
    margin: 0 auto 40px;
}
 

h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    text-align: center;
    letter-spacing: 0.12em;
    color: var(--text-mid);
    text-transform: uppercase;
    margin-bottom: 36px;
}
 

#productContainer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
    padding: 0 32px 64px;
    max-width: 1200px;
    margin: 0 auto;
}
 

#productContainer > div {
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 2px;
    width: 260px;
    padding: 24px;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
 
#productContainer > div:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
}
 

#productContainer img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    border-radius: 1px;
    margin-bottom: 16px;
    filter: brightness(0.97);
    transition: filter 0.3s ease;
}
 
#productContainer > div:hover img {
    filter: brightness(1.02);
}
 

#productContainer p {
    color: var(--text-mid);
    font-size: 13.5px;
    margin-bottom: 6px;
    line-height: 1.6;
}
 

#productContainer p:nth-of-type(1) {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-dark);
    letter-spacing: 0.02em;
    margin-bottom: 4px;
}
 

#productContainer p:nth-of-type(2) {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
}
 

#productContainer p:nth-of-type(3) {
    font-size: 13px;
    font-weight: 300;
    color: var(--text-light);
    border-top: 1px solid var(--border);
    padding-top: 10px;
    margin-top: 4px;
}
 
#productContainer br {
    display: none;
}
 

@media (max-width: 640px) {
    nav {
        padding: 12px 20px;
        flex-wrap: wrap;
        gap: 6px;
    }
 
    h1 {
        font-size: 2.2rem;
        padding: 32px 16px 8px;
    }
 
    #productContainer {
        gap: 20px;
        padding: 0 16px 48px;
    }
 
    #productContainer > div {
        width: 100%;
        max-width: 360px;
    }
}
